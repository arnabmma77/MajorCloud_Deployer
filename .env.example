# OpenWeatherMap API Configuration
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-1

# Application Configuration
ENVIRONMENT=prod
PORT=8080
FLASK_ENV=production

# Optional: Custom Domain Configuration
DOMAIN_NAME=your-domain.com

# Docker Configuration
ECR_REPOSITORY=weather-app
IMAGE_TAG=latest

# Terraform Configuration
TF_VAR_environment=prod
TF_VAR_aws_primary_region=us-east-1
TF_VAR_aws_secondary_region=us-west-2
TF_VAR_openweather_api_key=your_openweathermap_api_key_here
TF_VAR_domain_name=your-domain.com
TF_VAR_enable_disaster_recovery=true

# ECS Configuration
ECS_CLUSTER_NAME=weather-app-cluster
ECS_SERVICE_NAME=weather-app-service
ECS_DESIRED_COUNT=2
ECS_TASK_CPU=512
ECS_TASK_MEMORY=1024

# Auto Scaling Configuration
ENABLE_AUTO_SCALING=true
AUTO_SCALING_MIN_CAPACITY=2
AUTO_SCALING_MAX_CAPACITY=10

# Monitoring Configuration
LOG_RETENTION_DAYS=14
HEALTH_CHECK_GRACE_PERIOD=300

# S3 Configuration
S3_BUCKET_NAME=weather-app-static-assets

# GitHub Actions Secrets (for reference)
# Set these in your GitHub repository secrets:
# - AWS_ACCESS_KEY_ID
# - AWS_SECRET_ACCESS_KEY
# - OPENWEATHER_API_KEY
# - DOMAIN_NAME (optional)

# Local Development
# For local development, copy this file to .env and fill in your values
# The .env file is gitignored for security

# Security Notes:
# - Never commit actual API keys or secrets to version control
# - Use AWS IAM roles with minimal permissions
# - Rotate API keys regularly
# - Use AWS Secrets Manager for production deployments
# - Enable CloudTrail for audit logging
